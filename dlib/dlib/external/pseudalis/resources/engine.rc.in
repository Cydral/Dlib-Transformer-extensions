// Version information of an engine library (generated from resources/engine.rc.in).

#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/common/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
PRODUCTVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PSEUDALIS_PUBLISHER
            VALUE "FileDescription", "@PSEUDALIS_RC_DESCRIPTION@"
            VALUE "FileVersion", PSEUDALIS_VERSION
            VALUE "InternalName", "@PSEUDALIS_RC_FILE@"
            VALUE "LegalCopyright", PSEUDALIS_COPYRIGHT
            VALUE "OriginalFilename", "@PSEUDALIS_RC_FILE@"
            VALUE "ProductName", PSEUDALIS_FULL_NAME
            VALUE "ProductVersion", PSEUDALIS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
