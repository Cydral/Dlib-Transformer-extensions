// Resources of pseudalis-tray.exe.

#include <winver.h>
#include <winuser.h>
#include "resource.h"
#include "../common/version.h"

LANGUAGE 0, 0

1 24 "tray.manifest"

IDI_APP ICON "../resources/pseudalis.ico"
IDI_TRAY ICON "../resources/tray.ico"
IDI_TRAY_OFF ICON "../resources/tray-off.ico"
IDI_TRAY_UPDATE ICON "../resources/tray-update.ico"
IDB_ABOUT RCDATA "../resources/about.png"
IDB_MARK RCDATA "../resources/mark.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
PRODUCTVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PSEUDALIS_AUTHOR_NAME
            VALUE "FileDescription", "Pseudalis notification icon"
            VALUE "FileVersion", PSEUDALIS_VERSION
            VALUE "InternalName", "pseudalis-tray"
            VALUE "LegalCopyright", PSEUDALIS_COPYRIGHT
            VALUE "OriginalFilename", "pseudalis-tray.exe"
            VALUE "ProductName", PSEUDALIS_FULL_NAME
            VALUE "ProductVersion", PSEUDALIS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
