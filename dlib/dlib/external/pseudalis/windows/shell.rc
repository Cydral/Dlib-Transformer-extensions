// Resources of pseudalis.exe, the commands of the Explorer.

#include <winver.h>
#include <winuser.h>
#include "resource.h"
#include "../common/version.h"

LANGUAGE 0, 0

1 24 "shell.manifest"

IDI_APP ICON "../resources/pseudalis.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
PRODUCTVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PSEUDALIS_PUBLISHER
            VALUE "FileDescription", "Pseudalis commands"
            VALUE "FileVersion", PSEUDALIS_VERSION
            VALUE "InternalName", "pseudalis"
            VALUE "LegalCopyright", PSEUDALIS_COPYRIGHT
            VALUE "OriginalFilename", "pseudalis.exe"
            VALUE "ProductName", PSEUDALIS_FULL_NAME
            VALUE "ProductVersion", PSEUDALIS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

/*
    The texts of the commands of the Explorer, which the Explorer loads in the language of each
    user (the indirect strings of MUIVerb).  No table is neutral: the resource loader would take
    a neutral table before the one of the language of the user.  Each language is given under
    its neutral sublanguage and under those of its countries, English, first, under its own:
    the loader falls back on it for a language that Pseudalis does not speak.  shell_verbs.rc2
    writes the table of the texts VERB_*.
*/

// English.
#define VERB_PROTECT_TAGS "Anonymize with tags"
#define VERB_PROTECT_BARE "Anonymize without tags"
#define VERB_PROTECT_COPY_TAGS "Anonymize as a copy, with tags"
#define VERB_PROTECT_COPY_BARE "Anonymize as a copy, without tags"
#define VERB_RESTORE "Restore the original"
#define VERB_RESTORE_COPY "Restore as a copy"
LANGUAGE 0x09, 0x01
#include "shell_verbs.rc2"
LANGUAGE 0x09, 0x02
#include "shell_verbs.rc2"
LANGUAGE 0x09, 0x00
#include "shell_verbs.rc2"
#undef VERB_PROTECT_TAGS
#undef VERB_PROTECT_BARE
#undef VERB_PROTECT_COPY_TAGS
#undef VERB_PROTECT_COPY_BARE
#undef VERB_RESTORE
#undef VERB_RESTORE_COPY

// French.
#define VERB_PROTECT_TAGS "Anonymiser avec balises"
#define VERB_PROTECT_BARE "Anonymiser sans balises"
#define VERB_PROTECT_COPY_TAGS "Anonymiser dans une copie, avec balises"
#define VERB_PROTECT_COPY_BARE "Anonymiser dans une copie, sans balises"
#define VERB_RESTORE "Restaurer l'original"
#define VERB_RESTORE_COPY "Restaurer dans une copie"
LANGUAGE 0x0c, 0x00
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x01
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x02
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x03
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x04
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x05
#include "shell_verbs.rc2"
LANGUAGE 0x0c, 0x06
#include "shell_verbs.rc2"
#undef VERB_PROTECT_TAGS
#undef VERB_PROTECT_BARE
#undef VERB_PROTECT_COPY_TAGS
#undef VERB_PROTECT_COPY_BARE
#undef VERB_RESTORE
#undef VERB_RESTORE_COPY

