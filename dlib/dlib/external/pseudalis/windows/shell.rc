// Resources of pseudalis.exe, the commands of the Explorer.

#include <winver.h>
#include <winuser.h>
#include "resource.h"
#include "../common/version.h"

LANGUAGE 0, 0

1 24 "shell.manifest"

IDI_APP ICON "../resources/pseudalis.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
PRODUCTVERSION PSEUDALIS_VERSION_MAJOR, PSEUDALIS_VERSION_MINOR, PSEUDALIS_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", PSEUDALIS_PUBLISHER
            VALUE "FileDescription", "Pseudalis commands"
            VALUE "FileVersion", PSEUDALIS_VERSION
            VALUE "InternalName", "pseudalis"
            VALUE "LegalCopyright", PSEUDALIS_COPYRIGHT
            VALUE "OriginalFilename", "pseudalis.exe"
            VALUE "ProductName", PSEUDALIS_PRODUCT_NAME
            VALUE "ProductVersion", PSEUDALIS_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
