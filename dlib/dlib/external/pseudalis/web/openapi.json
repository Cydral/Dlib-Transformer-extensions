 },
 "components": {
  "securitySchemes": {
   "admin": {
    "type": "apiKey",
    "in": "header",
    "name": "X-Pseudalis-Admin",
    "description": "The administration token of the data folder, which the users of this computer read."
   }
  },
  "responses": {
   "Error": {
    "description": "The error: its English text, its code and its values",
    "content": {
     "application/json": {
      "schema": {
       "$ref": "#/components/schemas/Error"
      }
     }
    }
   }
  },
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "error": {
      "type": "string"
     },
     "code": {
      "type": "string"
     },
     "args": {
      "type": "object"
     }
    }
   },
   "FileResult": {
    "type": "object",
    "properties": {
     "name": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "record": {
      "type": "integer"
     },
     "restored": {
      "type": "string",
      "enum": [
       "original",
       "picture",
       "tags"
      ]
     },
     "report": {
      "type": "object"
     },
     "data": {
      "type": "string",
      "format": "byte"
     }
    }
   },
   "Settings": {
    "type": "object",
    "properties": {
     "port": {
      "type": "integer",
      "default": 8444
     },
     "language": {
      "type": "string",
      "enum": [
       "auto",
       "en",
       "fr",
       "de",
       "it",
       "es"
      ]
     },
     "drive_letter": {
      "type": "string",
      "example": "A"
     },
     "date_order": {
      "type": "string",
      "enum": [
       "dmy",
       "mdy"
      ]
     },
     "albireo": {
      "type": "string",
      "enum": [
       "auto",
       "off"
      ]
     },
     "max_file_mb": {
      "type": "integer"
     },
     "removed_days": {
      "type": "integer",
      "description": "The days the original of a file removed from the drive stays kept, 1 to 3650"
     },
     "check_updates": {
      "type": "boolean"
     },
     "trust_authority": {
      "type": "boolean"
     },
     "public_link": {
      "type": "string"
     },
     "feed_url": {
      "type": "string"
     },
     "proxy": {
      "type": "string"
     }
    }
   }
  }
 }
