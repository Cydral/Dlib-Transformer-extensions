         },
         "passphrase": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "passphrase"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "Imported",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Error"
     },
     "422": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/logs": {
