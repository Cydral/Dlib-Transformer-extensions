    "tags": [
     "Administration"
    ],
    "summary": "Export the master key, protected by a passphrase",
    "description": "Keep the export apart: with its passphrase, it restores every file this installation protected, on another computer too.",
    "security": [
     {
      "admin": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "passphrase": {
          "type": "string",
          "minLength": 12
         }
        },
        "required": [
         "passphrase"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "{\"key\": exported document}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     },
     "401": {
      "$ref": "#/components/responses/Error"
     },
     "422": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/key/import": {
   "post": {
    "tags": [
     "Administration"
    ],
    "summary": "Import the master key of an earlier installation",
    "description": "Accepted while no file is recorded; the service restarts with the key.",
    "security": [
     {
      "admin": []
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
