{
 "openapi": "3.0.3",
 "info": {
  "title": "Pseudalis interface",
  "version": "1.0.0",
  "description": "The local interface of Pseudalis, on this computer only (https://localhost:8444 by default). The files travel as they are, in the body of the requests. No account is needed; the operations of administration take the token of the data folder (%ProgramData%\\Pseudalis\\admin.token) in the X-Pseudalis-Admin header, which this page fills in by itself when the icon of Pseudalis opens it (Interface documentation), and which Authorize sets otherwise.",
  "contact": {
   "name": "Cydral Technology",
   "email": "cydraltechnology@gmail.com",
   "url": "https://github.com/Cydral/Dlib-Transformer-extensions"
  },
  "license": {
   "name": "Boost Software License 1.0",
   "url": "https://www.boost.org/LICENSE_1_0.txt"
  }
 },
 "servers": [
  {
   "url": "/"
  }
 ],
 "tags": [
  {
   "name": "Files"
  },
  {
   "name": "Texts"
  },
  {
   "name": "Drive"
  },
  {
   "name": "Service"
  },
  {
   "name": "Updates"
  },
  {
   "name": "Administration"
  }
 ],
 "paths": {
  "/v1/health": {
   "get": {
    "tags": [
     "Service"
    ],
    "summary": "Whether the service answers",
    "responses": {
     "200": {
      "description": "{\"status\": \"ok\", \"version\"}",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/v1/info": {
   "get": {
    "tags": [
     "Service"
    ],
    "summary": "The state of the service",
    "description": "Product, edition (\"Community\"), version, engine (variant, models), fingerprint of the key, drive (with error_code \"winfsp_missing\" when WinFsp is not installed), Albireo and the number of originals kept.",
    "responses": {
     "200": {
      "description": "The state",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
  "/v1/anonymize": {
   "post": {
    "tags": [
     "Files"
    ],
    "summary": "Protect a file",
    "description": "Protects a document (Word, Excel, PowerPoint, PDF, text, CSV, markup), a picture or an archive (ZIP, TAR, TAR.GZ) sent as the body. Each personal value becomes a tag [[TYPE:body#CCC]] encrypted under the key of this installation. A picture becomes the text file <name>.txt holding \"[Image@<id> : <description>]\", the description written by Albireo when it is installed; the pictures of Word documents, slides and PDF pages are replaced in place the same way. The entries of an archive of another kind are left out. With record (the default), the original is kept, encrypted, so that /v1/restore gives it back from any copy of the protected file. A body larger than the route takes is refused before it is read (413): the files up to max_file_mb of the settings, the JSON bodies up to 16 MB. When every slot of work stays taken for a minute, the answer is 503 with Retry-After (code busy).",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": false,
      "description": "The name of the file, whose extension tells its kind when its content does not",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "record",
      "in": "query",
      "required": false,
      "description": "Keep the original to restore it exactly",
      "schema": {
       "type": "boolean",
       "default": true
      }
     },
     {
      "name": "source",
      "in": "query",
      "required": false,
      "description": "Who asks: \"web\", \"shell\" or \"api\"",
      "schema": {
       "type": "string",
       "enum": [
        "api",
        "web",
        "shell"
       ],
       "default": "api"
      }
     },
     {
      "name": "format",
      "in": "query",
      "required": false,
      "description": "\"json\" for a JSON answer holding the file in base64",
      "schema": {
       "type": "string",
       "enum": [
        "binary",
        "json"
       ],
       "default": "binary"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/octet-stream": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      },
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "file": {
          "type": "string",
          "format": "binary"
         }
        },
        "required": [
         "file"
        ]
       }
      }
     },
     "description": "The file, as the body of the request, or as the first file of a multipart form, whose file name serves when the parameter name is absent."
    },
    "responses": {
     "200": {
      "description": "The file written, its name in Content-Disposition and X-Pseudalis-Name, its report in X-Pseudalis-Report; with format=json, a JSON object whose \"data\" holds it in base64.",
      "content": {
       "application/octet-stream": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FileResult"
        }
       }
      }
     },
     "413": {
      "$ref": "#/components/responses/Error"
     },
     "422": {
      "$ref": "#/components/responses/Error"
     },
     "503": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/restore": {
   "post": {
    "tags": [
     "Files"
    ],
    "summary": "Restore a file",
    "description": "Gives back the original of a protected file: the original kept when the body is a protected file this installation recorded (X-Pseudalis-restored: original), the picture of a text file holding a picture marker (picture), else the file with the values of its tags put back (tags). 404 when the file holds no value this key protected; 410 when the original of the file was forgotten (code original_forgotten) or kept for its time after the file left the drive (code original_expired), its date in args.date: such a file is not restored from its tags either. A body larger than the route takes is refused before it is read (413): the files up to max_file_mb of the settings, the JSON bodies up to 16 MB. When every slot of work stays taken for a minute, the answer is 503 with Retry-After (code busy).",
    "parameters": [
     {
      "name": "name",
      "in": "query",
      "required": false,
      "description": "The name of the file",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "object_id",
      "in": "query",
      "required": false,
      "description": "The NTFS object identifier of the file, when known (32 hexadecimal digits)",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "format",
      "in": "query",
      "required": false,
      "description": "\"json\" for a JSON answer holding the file in base64",
      "schema": {
       "type": "string",
       "enum": [
        "binary",
        "json"
       ],
       "default": "binary"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/octet-stream": {
       "schema": {
        "type": "string",
        "format": "binary"
       }
      },
      "multipart/form-data": {
       "schema": {
        "type": "object",
        "properties": {
         "file": {
          "type": "string",
          "format": "binary"
         }
        },
        "required": [
         "file"
        ]
       }
      }
     },
     "description": "The file, as the body of the request, or as the first file of a multipart form, whose file name serves when the parameter name is absent."
    },
    "responses": {
     "200": {
      "description": "The file written, its name in Content-Disposition and X-Pseudalis-Name, its report in X-Pseudalis-Report; with format=json, a JSON object whose \"data\" holds it in base64.",
      "content": {
       "application/octet-stream": {
        "schema": {
         "type": "string",
         "format": "binary"
        }
       },
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/FileResult"
        }
       }
      }
     },
     "404": {
      "$ref": "#/components/responses/Error"
     },
     "410": {
      "$ref": "#/components/responses/Error"
     },
     "413": {
      "$ref": "#/components/responses/Error"
     },
     "422": {
      "$ref": "#/components/responses/Error"
     },
     "503": {
      "$ref": "#/components/responses/Error"
     }
    }
   }
  },
  "/v1/lookup": {
   "get": {
    "tags": [
     "Files"
    ],
    "summary": "Whether a file is a protected file this installation recorded",
    "parameters": [
     {
      "name": "sha256",
      "in": "query",
      "required": false,
      "description": "The SHA-256 of the file, in hexadecimal",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "object_id",
      "in": "query",
      "required": false,
      "description": "Its NTFS object identifier",
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "description": "{\"known\", \"record\", \"output_name\", \"exact\"}; for a file not known whose original was forgotten, \"forgotten\": {\"time\", \"reason\"}, the reason \"forgotten\" or \"expired\"",
      "content": {
       "application/json": {
        "schema": {
         "type": "object"
        }
       }
      }
     }
    }
   }
  },
