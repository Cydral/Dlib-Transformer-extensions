// Resources of albireo-setup.exe (generated from windows/setup.rc.in): the payload is the
// archive of the programs made by the build.

#include <winver.h>
#include <winuser.h>
#include "@ALBIREO_WINDOWS_DIR@/resource.h"
#include "@ALBIREO_SOURCE_DIR@/common/version.h"

LANGUAGE 0, 0

1 24 "@ALBIREO_WINDOWS_DIR@/setup.manifest"

IDI_APP ICON "@ALBIREO_SOURCE_DIR@/resources/albireo.ico"
IDB_SIDE RCDATA "@ALBIREO_SOURCE_DIR@/resources/setup-side.png"
IDR_LICENSE RCDATA "@ALBIREO_SOURCE_DIR@/resources/license.txt"
IDR_PAYLOAD RCDATA "@ALBIREO_PAYLOAD@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
PRODUCTVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ALBIREO_COMPANY_NAME
            VALUE "FileDescription", "Albireo setup"
            VALUE "FileVersion", ALBIREO_VERSION
            VALUE "InternalName", "albireo-setup"
            VALUE "LegalCopyright", ALBIREO_COPYRIGHT
            VALUE "OriginalFilename", "albireo-setup.exe"
            VALUE "ProductName", ALBIREO_PRODUCT_NAME
            VALUE "ProductVersion", ALBIREO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
