// Resources of albireo-tray.exe.

#include <winver.h>
#include <winuser.h>
#include "resource.h"
#include "../common/version.h"

LANGUAGE 0, 0

1 24 "tray.manifest"

IDI_APP ICON "../resources/albireo.ico"
IDI_TRAY ICON "../resources/tray.ico"
IDI_TRAY_BUSY ICON "../resources/tray-busy.ico"
IDI_TRAY_OFF ICON "../resources/tray-off.ico"
IDI_TRAY_UPDATE ICON "../resources/tray-update.ico"
IDB_ABOUT RCDATA "../resources/about.png"
IDB_MARK RCDATA "../resources/mark.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
PRODUCTVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ALBIREO_COMPANY_NAME
            VALUE "FileDescription", "Albireo"
            VALUE "FileVersion", ALBIREO_VERSION
            VALUE "InternalName", "albireo-tray"
            VALUE "LegalCopyright", ALBIREO_COPYRIGHT
            VALUE "OriginalFilename", "albireo-tray.exe"
            VALUE "ProductName", ALBIREO_PRODUCT_NAME
            VALUE "ProductVersion", ALBIREO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
