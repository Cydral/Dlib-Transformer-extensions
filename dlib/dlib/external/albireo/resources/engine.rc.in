// Version information of an engine library (generated from resources/engine.rc.in).

#include <winver.h>
#include "@CMAKE_CURRENT_SOURCE_DIR@/common/version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
PRODUCTVERSION ALBIREO_VERSION_MAJOR, ALBIREO_VERSION_MINOR, ALBIREO_VERSION_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ALBIREO_COMPANY_NAME
            VALUE "FileDescription", "@ALBIREO_RC_DESCRIPTION@"
            VALUE "FileVersion", ALBIREO_VERSION
            VALUE "InternalName", "@ALBIREO_RC_FILE@"
            VALUE "LegalCopyright", ALBIREO_COPYRIGHT
            VALUE "OriginalFilename", "@ALBIREO_RC_FILE@"
            VALUE "ProductName", ALBIREO_PRODUCT_NAME
            VALUE "ProductVersion", ALBIREO_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
